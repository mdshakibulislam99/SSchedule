{
	"appId": "com.sschedule.app",
	"appName": "SSchedule",
	"webDir": "dist",
	"android": {
		"backgroundColor": "#4F46E5"
	},
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SocialLogin": {
			"providers": {
				"google": true,
				"facebook": false,
				"apple": false,
				"twitter": false
			}
		},
		"SplashScreen": {
			"launchShowDuration": 1000,
			"backgroundColor": "#4F46E5",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP"
		},
		"LocalNotifications": {
			"smallIcon": "ic_launcher_round",
			"iconColor": "#4F46E5"
		}
	}
}
