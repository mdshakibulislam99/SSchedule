<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome notification status-bar icon.
  Android renders notification small icons as a flat white silhouette using the
  alpha channel only, so a single solid shape with the brand indigo applied via
  iconColor is correct. This MUST live in res/drawable because the Capacitor
  local-notifications plugin resolves `smallIcon` via
  AssetUtil.getResourceID(ctx, name, "drawable") — a mipmap-only launcher icon
  (ic_launcher_round) resolves to resource id 0 and the notification is silently
  dropped. Referenced by reminderBuilder's NOTIFICATION_SMALL_ICON.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
