{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with academic program, goals, energy level, and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "university": { "type": "string" },
        "studyField": { "type": "string" },
        "year": { "type": "string" },
        "energyLevel": { "type": "number" },
        "streak": { "type": "number" },
        "goals": { "type": "array" },
        "isOnboarded": { "type": "boolean" },
        "preferredModel": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Student assignment, exam prep, or study task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "course": { "type": "string" },
        "deadline": { "type": "string" },
        "priority": { "type": "string" },
        "estimatedMinutes": { "type": "number" },
        "completed": { "type": "boolean" },
        "subtasks": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "course", "deadline", "priority", "estimatedMinutes", "completed"]
    },
    "Course": {
      "title": "Course",
      "description": "A course workspace with modules, objectives, and linked resources",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "professor": { "type": "string" },
        "term": { "type": "string" },
        "credits": { "type": "number" },
        "description": { "type": "string" },
        "objectives": { "type": "array" },
        "modules": { "type": "array" },
        "resourceIds": { "type": "array" },
        "studyPlan": { "type": "array" }
      },
      "required": ["id", "userId", "code", "name", "color"]
    },
    "CourseResource": {
      "title": "CourseResource",
      "description": "Readable course material with reading progress",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "courseCode": { "type": "string" },
        "moduleId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "estimatedReadMinutes": { "type": "number" },
        "tags": { "type": "array" },
        "reading": { "type": "object" }
      },
      "required": ["id", "userId", "courseId", "title"]
    },
    "ScheduleEvent": {
      "title": "ScheduleEvent",
      "description": "Calendar event, class, or study block",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "color": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "location": { "type": "string" }
      },
      "required": ["id", "userId", "title", "startTime", "endTime", "date", "type"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Academic or personal student goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "targetDate": { "type": "string" },
        "progress": { "type": "number" },
        "completed": { "type": "boolean" },
        "aiPlanSteps": { "type": "array" }
      },
      "required": ["id", "userId", "title", "category", "targetDate", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document owned by the authenticated student"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Student tasks scoped to the user"
    },
    "/users/{userId}/courses/{courseId}": {
      "schema": "Course",
      "description": "Course workspaces owned by the student"
    },
    "/users/{userId}/resources/{resourceId}": {
      "schema": "CourseResource",
      "description": "Course resources with reading progress"
    },
    "/users/{userId}/schedule/{eventId}": {
      "schema": "ScheduleEvent",
      "description": "Student schedule events scoped to the user"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Student study goals scoped to the user"
    }
  }
}
